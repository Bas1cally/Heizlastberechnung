    "check": "npm run build && node dist/src/check.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  }
}
