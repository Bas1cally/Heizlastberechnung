# Variable names only. Copy to .env and fill in. Never commit .env.

# ---- Venice Director (pnpm director) ----

# Venice video API: quote / queue / retrieve. Without it the quote button is off.
VENICE_API_KEY=

# Claude, only for draft / review_fix / translate (single messages, no history).
# Without it those buttons are off.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Jev gate (TypeSafe). Without it the gate button is off.
TYPESAFE_API_KEY=

# Optional. USD per million Claude tokens for the cost counter (defaults 15 / 75).
CLAUDE_USD_PER_MTOKEN_IN=
CLAUDE_USD_PER_MTOKEN_OUT=

# Optional. UI port (default 8787), data folder (default data/director).
DIRECTOR_PORT=
DIRECTOR_DATA=

# Optional. ffmpeg / ffprobe binaries for the review frames (default: on PATH).
FFMPEG=
FFPROBE=

# The trading experiment is over (STOP file). Its variables are read by
# src/app/config.ts and documented in docs/RISK.md; they are not needed here.
