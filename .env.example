# Variable names only. Copy to .env and fill in. Never commit .env.

# ---- Venice Director (pnpm director) ----

# Venice: video API (quote / queue / retrieve) AND, by default, the text model behind
# draft / review_fix / translate. One key, one balance. Without it the quote and text buttons are off.
VENICE_API_KEY=
# Text model on Venice (ids from `pnpm director:probe`, needs supportsResponseSchema). Default kimi-k2-6.
VENICE_TEXT_MODEL=kimi-k2-6
# reasoning_effort sent with each text call (none/low/medium/high); low keeps the thinking tokens small.
VENICE_TEXT_REASONING=low

# Optional: Anthropic directly instead of the Venice text model (needs Anthropic credit).
# TEXT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Jev gate (TypeSafe). Without it the gate button is off.
TYPESAFE_API_KEY=

# Optional. USD per million text-model tokens for the cost counter. Venice prices are read
# from the model list automatically; Anthropic defaults to 15 / 75.
TEXT_USD_PER_MTOKEN_IN=
TEXT_USD_PER_MTOKEN_OUT=

# Optional. UI port (default 8787), data folder (default data/director).
DIRECTOR_PORT=
DIRECTOR_DATA=

# Optional. ffmpeg / ffprobe binaries for the review frames (default: on PATH).
FFMPEG=
FFPROBE=

# The trading experiment is over (STOP file). Its variables are read by
# src/app/config.ts and documented in docs/RISK.md; they are not needed here.
