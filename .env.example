# Copy to .env and fill in. Never commit .env — the key must stay server-side.
TYPESAFE_API_KEY=

# Base URL of the decisions API.
# Deliberately configurable: the documented host could not be verified from the
# build environment (see README, "Unverified contract"). Override it here once
# you have confirmed the correct one against the live docs.
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Model used for judgments.
TYPESAFE_MODEL=jev-latest
