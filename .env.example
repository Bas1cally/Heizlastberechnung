# Variable names only. Copy to .env and fill in. Never commit .env.

TYPESAFE_API_KEY=

POLYMARKET_PRIVATE_KEY=
POLYMARKET_DEPOSIT_WALLET=

DATABASE_URL=

BOT_MODE=observe

MAX_MARKET_EXPOSURE_USD=
MAX_TOTAL_EXPOSURE_USD=
MAX_UNPAIRED_EXPOSURE_USD=
MAX_DAILY_LOSS_USD=

MAX_CHAINLINK_AGE_MS=
MAX_ORDERBOOK_AGE_MS=
MAX_JEV_LATENCY_MS=
# Directional buys above the free-tail price (0.05) are off: measured 302 fills, the bought side won 21.5%, the market priced 28.8%. true only for an experiment.
ALLOW_DIRECTIONAL_BUYS=false

ENABLE_LIVE_TRADING=false

# USD per million Jev tokens, for the Jev-cost line in pnpm analyze (default 0)
TYPESAFE_USD_PER_MTOKEN=
# Simulated round-trip latency for pnpm bot:paper (default 350)
PAPER_LATENCY_MS=

# Fine-grained GitHub token (Contents: read/write on this repo) for pnpm sync, if git push has no usable login
GITHUB_SYNC_TOKEN=

# Public wallets whose Polymarket history pnpm sync keeps current for comparison (comma-separated); default: Animal00
TRADER_WALLETS=

# ---- Venice Director (pnpm director) ----
# Venice video API (quote / queue / retrieve). Without it the quote button is off.
VENICE_API_KEY=
# Claude for draft / review_fix / translate only (no history, strict JSON). Without it those buttons are off.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# USD per million tokens for the cost ledger (defaults 15 / 75)
CLAUDE_USD_PER_MTOKEN_IN=
CLAUDE_USD_PER_MTOKEN_OUT=
# Local UI port (default 8787) and data folder (default data/director)
DIRECTOR_PORT=
DIRECTOR_DATA=
# ffmpeg / ffprobe binaries for the review frames (default: on PATH)
FFMPEG=
FFPROBE=
