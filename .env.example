# Variable names only. Copy to .env and fill in. Never commit .env.

TYPESAFE_API_KEY=

POLYMARKET_PRIVATE_KEY=
POLYMARKET_DEPOSIT_WALLET=

DATABASE_URL=

BOT_MODE=observe

MAX_MARKET_EXPOSURE_USD=
MAX_TOTAL_EXPOSURE_USD=
MAX_UNPAIRED_EXPOSURE_USD=
MAX_DAILY_LOSS_USD=

MAX_CHAINLINK_AGE_MS=
MAX_ORDERBOOK_AGE_MS=
MAX_JEV_LATENCY_MS=

ENABLE_LIVE_TRADING=false

# USD per million Jev tokens, for the Jev-cost line in pnpm analyze (default 0)
TYPESAFE_USD_PER_MTOKEN=
# Simulated round-trip latency for pnpm bot:paper (default 350)
PAPER_LATENCY_MS=

# Fine-grained GitHub token (Contents: read/write on this repo) for pnpm sync, if git push has no usable login
GITHUB_SYNC_TOKEN=

# Public wallets whose Polymarket history pnpm sync keeps current for comparison (comma-separated); default: Animal00
TRADER_WALLETS=
